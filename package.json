{
  "name": "tauri-client",
  "version": "0.1.0",
  "description": "RapidMX native desktop and mobile client. A Tauri v2 shell that signs in to any self-hosted RapidMX server and holds multiple accounts open at once.",
  "type": "module",
  "private": true,
  "repository": "https://github.com/rapidmx/tauri-client",
  "author": "Jean-Philippe Steinmetz <rapidrests@gmail.com>",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "tauri": "tauri",
    "lint": "eslint ./src ./test",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch --coverage",
    "release": "npx @rapidrest/cli release"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5"
  },
  "dependencies": {
    "@rapidmx/react-shared": "link:../react-shared",
    "@rapidmx/web-client": "link:../web-client",
    "@rapidrest/react": "link:../../rapidrest/react",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tauri-plugin-secure-keystore": "^0.0.3-beta.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.3.8",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": ">=24.0.0"
  }
}
