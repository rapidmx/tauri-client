{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RapidMX",
  "version": "0.1.0",
  "identifier": "io.rapidmx.tauri-client",
  "build": {
    "beforeDevCommand": "yarn dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RapidMX",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: https://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' https: ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["rapidmx"]
      },
      "mobile": [
        {
          "scheme": ["rapidmx"],
          "host": "auth",
          "pathPrefix": ["/callback"]
        }
      ]
    }
  }
}
